#include <iostream>

using namespace std;

int main() {
    // 1. Инициализация массива пользователем
    double arr[5];
    cout << "Введите 5 чисел для массива:" << endl;
    for (int i = 0; i < 5; i++) {
        cout << "Элемент [" << i + 1 << "]: ";
        cin >> arr[i];
    }

    cout << "\nРезультаты вычислений:\n";

    // 2. Вывод 5-ти таблиц
    for (int i = 0; i < 5; i++) {
        double x = arr[i];
        
        cout << "------------------------------------------" << endl;
        cout << "| Таблица: " << i + 1 << "                             |" << endl;
        cout << "------------------------------------------" << endl;
        cout << "|  Число  |      Пример      |  Результат  |" << endl;
        cout << "------------------------------------------" << endl;

        // Внутренний цикл для вывода строк таблицы (согласно требованию задания)
        for (int step = 0; step < 4; step++) {
            cout << "|    " << x << "    |      ";
            
            if (step == 0) {
                cout << x << " + " << x << "      |    " << x + x;
            } else if (step == 1) {
                cout << x << " - " << x << "      |    " << x - x;
            } else if (step == 2) {
                if (x != 0) {
                    cout << x << " / " << x << "      |    " << x / x;
                } else {
                    cout << x << " / " << x << "      |  Ошибка(0)";
                }
            } else if (step == 3) {
                cout << x << " * " << x << "      |    " << x * x;
            }
            
            cout << "    |" << endl;
        }
        cout << "------------------------------------------" << endl << endl;
    }

    return 0;
}
